# Groq API key (server-only). Used by the AI analysis (POST /api/analyze) and
# the chatbot (POST /api/chat). Never prefix this with NEXT_PUBLIC_ so it stays
# on the server and never reaches the browser.
GROQ_API_KEY=your_key_here

# Optional: override the Groq model used for analysis and chat.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Upstash Redis REST credentials. Without them, rate limits and
# share links use process-local memory (local development only).
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Optional: header set by your platform or reverse proxy with the real client
# IP. Defaults to x-real-ip (Vercel). The proxy MUST overwrite it.
# TRUSTED_IP_HEADER=x-real-ip

# Optional: secret used to sign the prepare-phase analysis. Defaults to
# GROQ_API_KEY, so a separate value is only needed if you rotate the key.
# ANALYSIS_TOKEN_SECRET=your_signing_secret_here
